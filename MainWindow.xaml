<Window x:Class="UvncAddressBook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UVNC 地址簿管理器" Height="620" Width="960"
        MinWidth="640" MinHeight="420"
        FontFamily="Microsoft YaHei, Segoe UI" FontSize="13"
        Background="{StaticResource BgBrush}">

    <DockPanel>

        <!-- 顶部菜单 -->
        <Menu DockPanel.Dock="Top" Style="{StaticResource TopMenu}">
            <MenuItem Header="文件">
                <MenuItem Header="导出全部（备份）..." Click="MenuExportAll_Click">
                    <MenuItem.Icon><TextBlock Text="&#xE8B3;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource SubTextBrush}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="导入备份..." Click="MenuImport_Click">
                    <MenuItem.Icon><TextBlock Text="&#xE8B5;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource SubTextBrush}"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="设置" Click="MenuSettings_Click">
                    <MenuItem.Icon><TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource SubTextBrush}"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="退出" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="分组">
                <MenuItem Header="新建分组" Click="MenuNewGroup_Click">
                    <MenuItem.Icon><TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource SubTextBrush}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="重命名分组" Click="MenuRenameGroup_Click">
                    <MenuItem.Icon><TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource SubTextBrush}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="删除分组" Click="MenuDeleteGroup_Click">
                    <MenuItem.Icon><TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource SubTextBrush}"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="帮助">
                <MenuItem Header="关于" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- 底部状态栏 -->
        <StatusBar DockPanel.Dock="Bottom" Style="{StaticResource StatusBarStyle}">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="SelInfo" Text=""/>
            </StatusBarItem>
        </StatusBar>

        <!-- 主体：左树 + 右列表 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：分组工具条 + 树 -->
            <DockPanel Grid.Column="0" Background="{StaticResource PanelBrush}">
                <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Click="MenuNewGroup_Click" ToolTip="新建分组">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="新建" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="MenuRenameGroup_Click" ToolTip="重命名分组">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="重命名" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="MenuDeleteGroup_Click" ToolTip="删除分组">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="删除" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <TreeView Grid.Column="0" x:Name="Tree"
                          Style="{StaticResource TreeViewStyle}"
                          SelectedItemChanged="Tree_SelectedItemChanged"
                          PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                          AllowDrop="True"
                          PreviewDragOver="Tree_PreviewDragOver"
                          Drop="Tree_Drop">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,0,6,0" Foreground="{StaticResource SubTextBrush}"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="新建分组" Click="MenuNewGroup_Click">
                                <MenuItem.Icon><TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource SubTextBrush}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="新建子分组" Click="MenuNewSubGroup_Click">
                                <MenuItem.Icon><TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource SubTextBrush}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="重命名分组" Click="MenuRenameGroup_Click">
                                <MenuItem.Icon><TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource SubTextBrush}"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="删除分组" Click="MenuDeleteGroup_Click">
                                <MenuItem.Icon><TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource SubTextBrush}"/></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Style="{StaticResource SplitterStyle}" HorizontalAlignment="Stretch"/>

            <!-- 右侧：主机工具栏 + 搜索 + 列表 -->
            <Grid Grid.Column="2" Background="{StaticResource PanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 第 0 行：左侧操作按钮 + 右侧搜索框 -->
                <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                    <DockPanel LastChildFill="False">
                        <!-- 右侧搜索框：按名称/IP/备注实时筛选当前分组 -->
                        <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Style="{StaticResource SearchTextBox}" Width="240" Margin="0,0,4,0"
                                 ToolTip="按显示名称 / IP / 备注实时筛选当前分组主机"
                                 TextChanged="SearchBox_TextChanged"/>

                        <!-- 搜索区与操作区之间的分隔线 -->
                        <Separator DockPanel.Dock="Right" Style="{StaticResource ToolSep}" Margin="6,0,8,0"/>

                        <!-- 左侧主机操作工具条（用 StackPanel 避免 ToolBar 溢出下拉箭头） -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                        <Button x:Name="BtnAddHost" Style="{StaticResource ToolButton}" Click="BtnAddHost_Click" ToolTip="新建主机">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="新建主机" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnEditHost" Style="{StaticResource DefaultButton}" Click="BtnEditHost_Click" ToolTip="编辑选中的主机">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="编辑主机" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnDeleteHost" Style="{StaticResource DangerButton}" Click="BtnDeleteHost_Click" ToolTip="删除选中的主机">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="删除主机" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnConnectView" Style="{StaticResource DefaultButton}" Click="BtnConnectView_Click" ToolTip="仅查看连接">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="仅查看" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        </StackPanel>
                </DockPanel>
                </Border>

                <DataGrid Grid.Row="1" x:Name="Grid"
                          Style="{StaticResource DataGridStyle}"
                          IsReadOnly="True"
                          MouseDoubleClick="Grid_MouseDoubleClick"
                          SelectionChanged="Grid_SelectionChanged"
                          PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="Grid_PreviewMouseMove">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ColDisplayName" Header="显示名称" Binding="{Binding DisplayName}" Width="160"/>
                        <DataGridTextColumn x:Name="ColIp" Header="内网IP地址" Binding="{Binding IpAddress}" Width="140"/>
                        <DataGridTextColumn x:Name="ColPort" Header="端口" Binding="{Binding Port}" Width="64"/>
                        <DataGridTextColumn x:Name="ColMode" Header="默认连接模式" Binding="{Binding ModeText}" Width="100"/>
                        <DataGridTextColumn x:Name="ColComment" Header="备注" Binding="{Binding Comment}" Width="*"/>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="完全控制连接" Click="CtxConnectFull_Click">
                                <MenuItem.Icon><TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource SubTextBrush}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="仅查看连接" Click="CtxConnectView_Click">
                                <MenuItem.Icon><TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource SubTextBrush}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="编辑主机" Click="CtxEditHost_Click">
                                <MenuItem.Icon><TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource SubTextBrush}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="删除主机" Click="CtxDeleteHost_Click">
                                <MenuItem.Icon><TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource SubTextBrush}"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="导出选中主机..." Click="CtxExportSelected_Click">
                                <MenuItem.Icon><TextBlock Text="&#xE8B3;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource SubTextBrush}"/></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <!-- 空状态提示 -->
                <TextBlock Grid.Row="1" x:Name="EmptyHint"
                           Text="当前分组暂无主机，点击「新建主机」或右键列表添加"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource SubTextBrush}" FontSize="14"
                           Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
