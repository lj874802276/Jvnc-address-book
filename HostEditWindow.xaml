<Window x:Class="UvncAddressBook.HostEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="主机信息" Width="400" Height="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="显示名称"/>
        <TextBox x:Name="TxtName" Grid.Row="0" Grid.Column="1" Margin="0,2"/>

        <Label Grid.Row="1" Grid.Column="0" Content="内网IP地址"/>
        <TextBox x:Name="TxtIp" Grid.Row="1" Grid.Column="1" Margin="0,2"/>

        <Label Grid.Row="2" Grid.Column="0" Content="端口"/>
        <TextBox x:Name="TxtPort" Grid.Row="2" Grid.Column="1" Margin="0,2"/>

        <Label Grid.Row="3" Grid.Column="0" Content="默认连接模式"/>
        <ComboBox x:Name="CboMode" Grid.Row="3" Grid.Column="1" Margin="0,2">
            <ComboBoxItem Tag="FullControl" Content="完全控制"/>
            <ComboBoxItem Tag="ViewOnly" Content="仅查看"/>
        </ComboBox>

        <Label Grid.Row="4" Grid.Column="0" Content="备注"/>
        <TextBox x:Name="TxtComment" Grid.Row="4" Grid.Column="1" Margin="0,2"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Width="80" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="取消" Width="80" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
